---
interface Props {
  title: string;
  activeTab: 'agenda' | 'productividad' | 'recordatorios';
}

const { title, activeTab } = Astro.props;

const navItems = [
  { id: 'agenda', label: 'Agenda & Horarios', href: '/admin/agenda', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { id: 'productividad', label: 'Productividad & Liquidaciones', href: '/admin/productividad', icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z' },
  { id: 'recordatorios', label: 'Recordatorios (3 Semanas)', href: '/admin/recordatorios', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Admin Darshall Estudio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#F8F9FA] text-slate-800 font-sans min-h-screen flex flex-col md:flex-row antialiased">
    
    <!-- Sidebar Navegación Admin -->
    <aside class="w-full md:w-72 bg-white border-r border-slate-200/80 flex flex-col flex-shrink-0 min-h-screen">
      <!-- Brand Header -->
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-studio-500 to-amber-200 flex items-center justify-center text-white font-serif font-bold text-lg shadow-sm">
            D
          </div>
          <div>
            <span class="block font-serif text-lg font-bold text-slate-900 tracking-wide">DARSHALL</span>
            <span class="block text-[10px] uppercase font-bold tracking-widest text-studio-600">Panel Administrativo</span>
          </div>
        </a>
      </div>

      <!-- Links -->
      <nav class="p-4 space-y-1.5 flex-1">
        <div class="px-3 py-2 text-[11px] font-semibold tracking-wider text-slate-400 uppercase">
          Operaciones del Estudio
        </div>

        {navItems.map((item) => {
          const isActive = activeTab === item.id;
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-medium transition-all ${
                isActive
                  ? 'bg-gradient-to-r from-studio-50 to-rose-50/50 text-studio-700 border-l-4 border-studio-600 font-semibold shadow-sm'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-50'
              }`}
            >
              <svg class={`w-5 h-5 ${isActive ? 'text-studio-600' : 'text-slate-400'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon}></path>
              </svg>
              <span>{item.label}</span>
            </a>
          );
        })}

        <div class="pt-6 px-3 py-2 text-[11px] font-semibold tracking-wider text-slate-400 uppercase">
          Accesos Rápidos
        </div>
        <a
          href="/"
          target="_blank"
          class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-600 hover:text-studio-600 hover:bg-rose-50/40 transition-colors border border-dashed border-slate-200"
        >
          <span>Ver Formulario Público</span>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </nav>

      <!-- User / Studio Info Footer -->
      <div class="p-4 border-t border-slate-100 bg-slate-50/50">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-rose-200 text-studio-800 flex items-center justify-center text-xs font-bold">
            TB
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs font-semibold text-slate-800 truncate">Administradora</p>
            <p class="text-[11px] text-emerald-600 flex items-center gap-1 font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Sistema En Línea
            </p>
          </div>
        </div>
      </div>
    </aside>

    <!-- Content Workspace -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto">
      <!-- Topbar -->
      <header class="bg-white border-b border-slate-200/80 px-6 py-4 flex items-center justify-between">
        <h1 class="text-xl font-bold font-serif text-slate-900 tracking-tight">{title}</h1>
        <div class="flex items-center gap-3">
          <span class="text-xs px-2.5 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-full font-medium">
            Entorno: Vercel SSR + Supabase
          </span>
        </div>
      </header>

      <div class="p-6 md:p-8 max-w-7xl w-full mx-auto">
        <slot />
      </div>
    </main>

  </body>
</html>
