---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { formatDate, formatTime } from '../../lib/date-utils';
import type { Appointment, Specialist } from '../../types/database';

export const prerender = false;

// Parámetros de filtro de la URL
const url = new URL(Astro.request.url);
const selectedSpecialistId = url.searchParams.get('specialist_id') || 'all';
const selectedDate = url.searchParams.get('date') || new Date().toISOString().split('T')[0];

let specialists: Specialist[] = [];
let appointments: any[] = [];

try {
  // Cargar todas las manicuristas para el filtro
  const { data: rawSpecialists } = await supabaseAdmin
    .from('specialists')
    .select('*')
    .order('full_name');

  specialists = rawSpecialists || [];

  // Construcción de la consulta de citas para la fecha seleccionada
  const startOfDay = `${selectedDate}T00:00:00.000Z`;
  const endOfDay = `${selectedDate}T23:59:59.999Z`;

  let query = supabaseAdmin
    .from('appointments')
    .select(`
      id,
      appointment_date,
      status,
      notes,
      client_id,
      specialist_id,
      service_id,
      clients ( id, full_name, whatsapp_phone ),
      specialists ( id, full_name, commission_rate ),
      services ( id, name, price, duration_minutes )
    `)
    .gte('appointment_date', startOfDay)
    .lte('appointment_date', endOfDay)
    .order('appointment_date', { ascending: true });

  if (selectedSpecialistId !== 'all') {
    query = query.eq('specialist_id', selectedSpecialistId);
  }

  const { data: appointmentsRaw } = await query;
  appointments = appointmentsRaw || [];
} catch (e) {
  console.error('Error al cargar agenda:', e);
}

// Resumen del día
const totalAppointments = appointments.length;
const completedCount = appointments.filter(a => a.status === 'completed').length;
const inProgressCount = appointments.filter(a => a.status === 'in_progress').length;
const scheduledCount = appointments.filter(a => a.status === 'scheduled').length;
---

<AdminLayout title="Agenda Operativa y Horarios" activeTab="agenda">
  <!-- Filtros de Fecha y Especialista -->
  <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm mb-8 flex flex-col md:flex-row items-center justify-between gap-4">
    <form method="GET" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <div>
        <label for="date" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Fecha</label>
        <input
          type="date"
          id="date"
          name="date"
          value={selectedDate}
          onchange="this.form.submit()"
          class="px-3.5 py-2 rounded-xl border border-slate-300 text-sm font-medium focus:ring-2 focus:ring-studio-500/20 focus:outline-none"
        />
      </div>

      <div>
        <label for="specialist_id" class="block text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">Especialista</label>
        <select
          id="specialist_id"
          name="specialist_id"
          onchange="this.form.submit()"
          class="px-3.5 py-2 rounded-xl border border-slate-300 text-sm font-medium focus:ring-2 focus:ring-studio-500/20 focus:outline-none min-w-[200px]"
        >
          <option value="all" selected={selectedSpecialistId === 'all'}>✨ Todas las especialistas</option>
          {specialists.map((s) => (
            <option value={s.id} selected={selectedSpecialistId === s.id}>
              {s.full_name} ({s.is_active ? 'Activa' : 'Inactiva'})
            </option>
          ))}
        </select>
      </div>

      <div class="pt-5">
        <a href={`/admin/agenda?date=${new Date().toISOString().split('T')[0]}`} class="text-xs font-semibold text-studio-600 hover:text-studio-800 underline">
          Ir a Hoy
        </a>
      </div>
    </form>

    <!-- Resumen Contador -->
    <div class="flex items-center gap-2 text-xs">
      <span class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 font-medium">Total: <strong>{totalAppointments}</strong></span>
      <span class="px-3 py-1.5 rounded-lg bg-amber-50 text-amber-700 font-medium border border-amber-200">Agendadas: <strong>{scheduledCount}</strong></span>
      <span class="px-3 py-1.5 rounded-lg bg-blue-50 text-blue-700 font-medium border border-blue-200">En Mesa: <strong>{inProgressCount}</strong></span>
      <span class="px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 font-medium border border-emerald-200">Completadas: <strong>{completedCount}</strong></span>
    </div>
  </div>

  <!-- Vista Cronograma / Tarjetas de Citas -->
  {appointments.length === 0 ? (
    <div class="bg-white rounded-3xl border border-dashed border-slate-200 p-12 text-center">
      <div class="w-12 h-12 bg-rose-50 text-studio-500 rounded-full flex items-center justify-center mx-auto mb-3">
        📅
      </div>
      <h3 class="font-serif text-lg font-bold text-slate-800">No hay citas programadas para este día</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
        Cambia de fecha en el selector superior o comparte el link de agendamiento con tus clientas.
      </p>
    </div>
  ) : (
    <div class="space-y-4">
      {appointments.map((app) => {
        const client = app.clients;
        const specialist = app.specialists;
        const service = app.services;
        const appTime = formatTime(app.appointment_date);

        // Clases visuales según el estado
        let badgeColor = 'bg-amber-100 text-amber-800 border-amber-200';
        let statusLabel = 'Agendada';

        if (app.status === 'in_progress') {
          badgeColor = 'bg-blue-100 text-blue-800 border-blue-200 animate-pulse';
          statusLabel = 'En Servicio';
        } else if (app.status === 'completed') {
          badgeColor = 'bg-emerald-100 text-emerald-800 border-emerald-200';
          statusLabel = 'Completada ✓';
        } else if (app.status === 'cancelled') {
          badgeColor = 'bg-slate-100 text-slate-500 border-slate-200 line-through';
          statusLabel = 'Cancelada';
        }

        return (
          <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm hover:shadow-md transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
            <!-- Hora y Detalles del Servicio -->
            <div class="flex items-start gap-4">
              <div class="w-20 text-center flex-shrink-0">
                <span class="block font-serif text-xl font-bold text-slate-900">{appTime}</span>
                <span class="block text-[11px] font-medium text-slate-400">⏱ {service?.duration_minutes || 60}m</span>
              </div>

              <div class="h-12 w-px bg-slate-200 hidden sm:block"></div>

              <div>
                <div class="flex items-center gap-2">
                  <h4 class="font-bold text-base text-slate-900">{client?.full_name || 'Clienta'}</h4>
                  <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full border ${badgeColor}`}>
                    {statusLabel}
                  </span>
                </div>
                <p class="text-xs text-studio-600 font-semibold mt-0.5">
                  💅 {service?.name} — <span class="text-slate-700">${Number(service?.price || 0).toFixed(2)}</span>
                </p>
                <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mt-1.5">
                  <span>👩‍🎨 Especialista: <strong class="text-slate-700">{specialist?.full_name}</strong></span>
                  <span>•</span>
                  <a
                    href={`https://wa.me/${client?.whatsapp_phone?.replace(/[^0-9]/g, '')}`}
                    target="_blank"
                    class="text-emerald-600 hover:underline flex items-center gap-1 font-medium"
                  >
                    💬 {client?.whatsapp_phone}
                  </a>
                  {app.notes && (
                    <>
                      <span>•</span>
                      <span class="italic text-slate-400">"{app.notes}"</span>
                    </>
                  )}
                </div>
              </div>
            </div>

            <!-- Botones de Acción Rápida de Estados -->
            <div class="flex items-center gap-2 w-full md:w-auto justify-end border-t md:border-t-0 pt-3 md:pt-0">
              {app.status === 'scheduled' && (
                <button
                  type="button"
                  onclick={`updateAppointmentStatus('${app.id}', 'in_progress')`}
                  class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white shadow-sm transition-colors"
                >
                  ▶ Iniciar Servicio
                </button>
              )}

              {app.status === 'in_progress' && (
                <button
                  type="button"
                  onclick={`updateAppointmentStatus('${app.id}', 'completed')`}
                  class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-colors flex items-center gap-1.5"
                >
                  <span>✓ Marcar Completada</span>
                </button>
              )}

              {app.status === 'completed' && (
                <span class="text-xs text-emerald-700 font-semibold bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-200">
                  Comisión Registrada ✨
                </span>
              )}

              {app.status !== 'cancelled' && app.status !== 'completed' && (
                <button
                  type="button"
                  onclick={`updateAppointmentStatus('${app.id}', 'cancelled')`}
                  class="px-2.5 py-2 rounded-xl text-xs font-medium text-rose-600 hover:bg-rose-50 transition-colors"
                  title="Cancelar Cita"
                >
                  ✕ Cancelar
                </button>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}

  <script is:inline>
    async function updateAppointmentStatus(appointmentId, newStatus) {
      if (!confirm(`¿Confirmas cambiar el estado a '${newStatus}'?`)) return;

      try {
        const res = await fetch(`/api/appointments/${appointmentId}/status`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error al actualizar');

        window.location.reload();
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }
  </script>
</AdminLayout>
